  <PropertyGroup>
    <!-- 双版本部署：模组根目录版本文件夹（游戏 InitLoadFolders 机制，1.6 玩家只加载 1.6\，1.7 只加载 1.7\）。
         注意：不能放 Assemblies\1.6 子目录——Assemblies 是递归扫描的，会导致双版本 DLL 同时被加载冲突。 -->
    <PostBuildEvent Condition=" '$(GameVer)' == '16' ">@echo off
set MODDIR=D:\games\steamapps\common\Rimworld\Mods\MaiyaMod02 Rim Digital Life - Core 边缘数码生活核心版
if not exist "%MODDIR%\1.6\Assemblies" mkdir "%MODDIR%\1.6\Assemblies"
copy /Y "$(TargetDir)$(TargetName).dll" "%MODDIR%\1.6\Assemblies\"
</PostBuildEvent>
    <PostBuildEvent Condition=" '$(GameVer)' != '16' ">@echo off
set MODDIR=D:\games\steamapps\common\Rimworld\Mods\MaiyaMod02 Rim Digital Life - Core 边缘数码生活核心版
if not exist "%MODDIR%\1.7\Assemblies" mkdir "%MODDIR%\1.7\Assemblies"
copy /Y "$(TargetDir)$(TargetName).dll" "%MODDIR%\1.7\Assemblies\"

:: 暴力清空目标 Defs 文件夹 (防止旧文件残留)
if exist "%MODDIR%\Defs" rmdir /S /Q "%MODDIR%\Defs"

:: 重新复制 Defs / Textures / About / Languages
xcopy /E /I /Y "$(ProjectDir)Defs" "%MODDIR%\Defs"
xcopy /E /I /Y "$(ProjectDir)Textures" "%MODDIR%\Textures"
xcopy /E /I /Y "$(ProjectDir)About" "%MODDIR%\About"
xcopy /E /I /Y "$(ProjectDir)Languages" "%MODDIR%\Languages"
</PostBuildEvent>
