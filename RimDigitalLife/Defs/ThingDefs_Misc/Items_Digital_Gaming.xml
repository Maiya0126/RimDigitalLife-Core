		<comps>
			<li Class="RimDigitalLife.CompProperties_ConsoleControllers">
				<platform>Xbox</platform>
			</li>
		</comps>
		<modExtensions>
			<li Class="RimDigitalLife.ConsoleControllerExtension">
				<south>
					<li>(-0.4001563,0,-0.0308073)</li>
					<li>(0.4486600,0,-0.0308073)</li>
				</south>
				<east>
					<li>(0.2773889,0,-0.3318100)</li>
					<li>(0.2773889,0,0.2824083)</li>
				</east>
				<north>
					<li>(-0.5092898,0,0.5451752)</li>
					<li>(0.1515743,0,0.5451752)</li>
				</north>
				<west>
					<li>(-0.2864402,0,-0.3243776)</li>
					<li>(-0.2864402,0,0.2739641)</li>
				</west>
