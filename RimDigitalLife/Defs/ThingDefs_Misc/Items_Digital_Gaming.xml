	<!-- Riwitch 底座主机（Rimtendo 产品线：手持 Riwitch → 客厅底座形态；贴图风格与 Game Night 获授权素材一致） -->
	<ThingDef ParentName="Building_ConsoleBase">
		<defName>Building_Rimtendo_Dock</defName>
		<label>Riwitch Dock</label>
		<description>Rimtendo (任天缘) 的底座主机形态：一台插在充电底座上的 Riwitch 通过 HDMI 连接客厅屏幕。功耗低但欢乐不减，适合小客厅和朋友开黑。</description>
		<graphicData>
			<texPath>Things/Building/RiwitchDock</texPath>
		</graphicData>
		<uiIconPath>Things/Building/RiwitchDock_Icon</uiIconPath>
		<comps>
			<li Class="RimDigitalLife.CompProperties_ConsoleControllers">
				<platform>Switch</platform>
			</li>
		</comps>
		<modExtensions>
			<li Class="RimDigitalLife.ConsoleControllerExtension">
				<south>
					<li>(-0.3898803,0,-0.0322177)</li>
					<li>(0.4624162,0,-0.0322177)</li>
				</south>
				<east>
					<li>(0.3224698,0,-0.1933226)</li>
					<li>(0.3224698,0,0.5471635)</li>
				</east>
				<north>
					<li>(-0.5214157,0,0.5451752)</li>
					<li>(0.1394484,0,0.5451752)</li>
				</north>
				<west>
					<li>(-0.3400985,0,-0.1877038)</li>
					<li>(-0.3400985,0,0.5307065)</li>
				</west>
			</li>
		</modExtensions>
		<statBases>
			<MaxHitPoints>90</MaxHitPoints>
			<WorkToBuild>2600</WorkToBuild>
			<JoyGainFactor>1.3</JoyGainFactor>
			<Beauty>16</Beauty>
			<MarketValue>450</MarketValue>
			<Mass>14</Mass>
		</statBases>
		<costList>
			<Steel>65</Steel>
			<Plasteel>4</Plasteel>
			<ComponentIndustrial>3</ComponentIndustrial>
		</costList>
		<researchPrerequisites>
			<li>MicroelectronicsBasics</li>
		</researchPrerequisites>
	</ThingDef>

	<JoyGiverDef>
		<defName>Play_RimConsoles</defName>

		<giverClass>JoyGiver_WatchBuilding</giverClass>

		<baseChance>3</baseChance>
		<thingDefs>
<!--			<li>Building_Macrosoft_360Console</li>-->
			<li>Building_Macrosoft_SeriesX</li>
			<li>Building_RONY_Station</li>
<!--			<li>Building_RONY_StationPro</li>-->
			<li>Building_Rimtendo_Dock</li>
		</thingDefs>
		<jobDef>Play_GamingDexterity</jobDef>
		<joyKind>Gaming_Dexterity</joyKind>

		<canDoWhileInBed>true</canDoWhileInBed>
		<requiredCapacities>
			<li>Sight</li>
			<li>Manipulation</li>
		</requiredCapacities>
	</JoyGiverDef>

</Defs>